NODE_ENV=development

# Use mock locally; select "openai" or "gemini" to use a live AI provider.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used by AI_PROVIDER=gemini and POST /api/generate-tickets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Use mock locally; select "rest" to use Jira Cloud.
JIRA_PROVIDER=mock
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROD

LOG_LEVEL=info
